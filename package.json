{
  "name": "webapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "checks": "bash scripts/run-all-checks.sh",
    "types:gen": "supabase gen types typescript --local --schema public > src/lib/database.types.ts && prettier --write src/lib/database.types.ts",
    "types:check": "bash scripts/check-database-types.sh",
    "schema:gen": "bash scripts/check-schema.sh gen",
    "schema:check": "bash scripts/check-schema.sh check",
    "i18n:check": "tsx scripts/check-i18n-keys.ts",
    "migrations:check": "tsx scripts/check-migration-versions.ts",
    "migration:new": "tsx scripts/new-migration.ts",
    "scan:bundle": "tsx scripts/scan-bundle-for-secrets.ts",
    "bundle:check": "tsx scripts/check-bundle-size.ts",
    "third-party:check": "tsx scripts/check-third-party.ts",
    "issues:sync": "tsx scripts/sync-story-issues.ts",
    "emails:build": "tsx scripts/build-auth-email-templates.ts",
    "demo:build": "tsx scripts/build-demo-content.ts",
    "doodles:tokens": "tsx scripts/doodle-tokens.ts",
    "doodles:check": "tsx scripts/doodle-tokens.ts --check",
    "demo:compare-parts": "tsx scripts/compare-demo-parts.ts",
    "demo:check-2b": "tsx scripts/check-demo-content-2b.ts"
  },
  "dependencies": {
    "@dicebear/core": "9.4.3",
    "@dicebear/micah": "9.4.3",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@fontsource/shadows-into-light-two": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.106.1",
    "@tiptap/core": "3.32.3",
    "@tiptap/pm": "3.32.3",
    "@tiptap/react": "3.32.3",
    "@tiptap/starter-kit": "3.32.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "9.15.2",
    "i18next": "^26.7.2",
    "jszip": "3.10.2",
    "mdast-util-from-markdown": "2.1.0",
    "pdfmake": "0.3.13",
    "qrcode-generator": "2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "tailwind-merge": "^3.7.0",
    "unist-util-visit": "^5.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "^24.19.2",
    "@types/pdfmake": "0.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "6.2.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "supabase": "^2.121.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild": false
  }
}
