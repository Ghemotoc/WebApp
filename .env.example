# Example environment variables (story S1-E1-01).
# Copy this file to .env.local for local overrides. Never commit a real .env file.
# Every VITE_ variable ends up in the browser bundle, so only public values belong here:
# never a service role key, password or API secret (CLAUDE.md rule 2).

# Brand values. Leave them empty to use today's values from src/config/brand.ts
# (decided 17 Oct 2026, 12:47 and 12:50). Set them in Cloudflare Pages when the name changes.
VITE_BRAND_NAME=
VITE_BRAND_SITE_DOMAIN=
VITE_BRAND_CONTACT_EMAIL=
VITE_BRAND_SUPPORT_EMAIL=
VITE_BRAND_SOCIAL_HANDLE=

# Supabase project the app talks to. `npx supabase start` prints the local values.
# The first story that calls Supabase from the app (S1-E1-02 or S1-E2-01) starts reading these.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
